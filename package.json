{
  "name": "node-bmw-mid",
  "version": "0.0.7",
  "description": "nodejs bmw ibus mid transceiver",
  "main": "build/main.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/main.js",
    "dev": "LOG_LEVEL=debug tsx watch src/main.ts",
    "ibus-log": "tsx src/ibus-monitor.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src test",
    "format": "oxfmt src test",
    "format:check": "oxfmt --check src test"
  },
  "engines": {
    "node": ">= 24"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/latinize": "^0.2.18",
    "@types/log": "^6.3.3",
    "@types/node": "^24",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "dotenv": "^17.4.2",
    "hono": "^4.13.4",
    "latinize": "^2.0.0",
    "log": "^6.3.2",
    "log-node": "^8.0.3",
    "node-roon-api": "github:RoonLabs/node-roon-api",
    "node-roon-api-status": "github:RoonLabs/node-roon-api-status",
    "node-roon-api-transport": "github:RoonLabs/node-roon-api-transport",
    "pigpio-client": "^1.5.3",
    "serialport": "^13.0.0",
    "zod": "^4.6.5"
  }
}
