{
  "name": "node-bmw-mid",
  "version": "0.0.7",
  "description": "nodejs bmw ibus mid transceiver",
  "main": "build/main.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "dev": "LOG_LEVEL=debug tsx watch --env-file-if-exists=.env src/main.ts",
    "ibus-log": "tsx --env-file-if-exists=.env src/ibus-monitor.ts",
    "ibus-bridge": "tsx --env-file-if-exists=.env src/ibus-bridge.ts",
    "start:ibus-bridge": "node --env-file-if-exists=.env dist/src/ibus-bridge.js",
    "dspc-probe": "tsx --env-file-if-exists=.env src/tools/dspc-probe/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src test",
    "format": "oxfmt src test",
    "format:check": "oxfmt --check src test"
  },
  "engines": {
    "node": ">= 26"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/latinize": "^0.2.18",
    "@types/log": "^6.3.3",
    "@types/node": "^26",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "latinize": "^2.0.0",
    "log": "^6.3.2",
    "log-node": "^8.0.3",
    "node-roon-api": "github:RoonLabs/node-roon-api",
    "node-roon-api-status": "github:RoonLabs/node-roon-api-status",
    "node-roon-api-transport": "github:RoonLabs/node-roon-api-transport",
    "pigpio-client": "^1.5.3",
    "serialport": "^13.0.0",
    "zod": "^4.6.7"
  }
}
